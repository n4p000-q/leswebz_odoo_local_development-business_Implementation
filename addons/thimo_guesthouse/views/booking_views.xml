<odoo>
    <record id="view_thimo_booking_list" model="ir.ui.view"><field name="name">thimo.booking.list</field><field name="model">thimo.booking</field><field name="arch" type="xml"><list><field name="name"/><field name="guest_id"/><field name="room_id"/><field name="check_in_date"/><field name="check_out_date"/><field name="nights"/><field name="total_amount"/><field name="state"/></list></field></record>
    <record id="view_thimo_booking_form" model="ir.ui.view"><field name="name">thimo.booking.form</field><field name="model">thimo.booking</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/><button name="action_check_in" type="object" string="Check In" class="oe_highlight" invisible="state != 'confirmed'"/><button name="action_check_out" type="object" string="Check Out" class="oe_highlight" invisible="state != 'checked_in'"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('checked_out','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,confirmed,checked_in,checked_out"/></header><sheet><group><group><field name="name" readonly="1"/><field name="guest_id"/><field name="room_id"/><field name="room_type_id" readonly="1"/><field name="rate_id"/></group><group><field name="check_in_date"/><field name="check_out_date"/><field name="nights" readonly="1"/><field name="price_per_night" readonly="1"/><field name="total_amount" readonly="1"/></group></group><field name="notes"/></sheet></form></field></record>
    <record id="action_thimo_booking" model="ir.actions.act_window"><field name="name">Bookings</field><field name="res_model">thimo.booking</field><field name="view_mode">list,form</field></record>
</odoo>
